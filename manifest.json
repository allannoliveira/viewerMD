{
  "manifest_version": 3,
  "name": "Viewer MD",
  "version": "1.1.0",
  "description": "Renderiza arquivos Markdown (.md) direto no Chrome, locais ou da web.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown",
        "file:///*.mdown",
        "http://*/*.md",
        "https://*/*.md",
        "http://*/*.markdown",
        "https://*/*.markdown"
      ],
      "js": [
        "lib/marked.min.js",
        "lib/purify.min.js",
        "lib/highlight.min.js",
        "lib/mermaid.min.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.css",
        "lib/hljs-light.css",
        "lib/hljs-dark.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
